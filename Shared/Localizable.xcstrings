    "联动不能形成循环，请选择其他计数器。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联动不能形成循环，请选择其他计数器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links can’t form a loop. Please choose another counter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯動不能形成循環，請選擇其他計數器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連動がループになります。別のカウンターを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연동이 고리를 이룰 수 없습니다. 다른 카운터를 고르세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfungen dürfen keine Schleife bilden. Wähle einen anderen Zähler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vínculos no pueden formar un círculo. Elige otro contador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens ne peuvent pas former une boucle. Choisis un autre compteur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vínculos não podem formar um círculo. Escolha outro contador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I collegamenti non possono formare un cerchio. Scegli un altro contatore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelingen kunnen geen cirkel vormen. Kies een andere teller."
          }
        }
      }
