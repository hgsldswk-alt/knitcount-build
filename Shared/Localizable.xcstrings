    "填 0 表示不循环；每圈针数表会自动替代针计数的循环值。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填 0 表示不循环；每圈针数表会自动替代针计数的循环值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 0 for no repeat. Round stitch targets automatically override the stitch counter’s repeat limit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填 0 表示不循環；每圈針數表會自動替代針計數的循環值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返さない場合は0にします。段ごとの目数目標がある場合は、目数カウンターの繰り返し上限より優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복하지 않으려면 0을 쓰세요. 원형 코수 목표는 코 카운터의 반복 제한보다 우선합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0 für keine Wiederholung. Maschenziele pro Runde haben automatisch Vorrang vor dem Wiederholungslimit des Maschenzählers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa 0 para no repetir. Las metas de puntos por vuelta tienen prioridad sobre el límite de repetición del contador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets 0 pour ne pas répéter. Les objectifs de mailles par rang priment sur la limite de répétition du compteur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 0 para não repetir. As metas de pontos por carreira têm prioridade sobre o limite de repetição do contador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa 0 per non ripetere. Gli obiettivi di punti per giro hanno la precedenza sul limite di ripetizione del contatore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik 0 om niet te herhalen. Steekdoelen per toer gaan voor de herhaallimiet van de teller."
          }
        }
      }
    },
