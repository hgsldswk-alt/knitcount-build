    "点选目标左上角。整块放得下才会应用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点选目标左上角。整块放得下才会应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the destination’s top-left cell. The entire selection must fit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選目標的左上角。整塊放得下才會套用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先の左上のマスをタップしてください。選択範囲がすべて収まる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮길 곳의 왼쪽 위 칸을 탭하세요. 선택 영역이 모두 들어가야 합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Kästchen oben links am Ziel. Die ganze Auswahl muss hineinpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la celda superior izquierda del destino. Toda la selección debe caber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche la case en haut à gauche de la destination. Toute la sélection doit tenir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na célula superior esquerda do destino. A seleção inteira precisa caber."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la cella in alto a sinistra della destinazione. Tutta la selezione deve starci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het vakje linksboven van de bestemming. De hele selectie moet erin passen."
          }
        }
      }
    },
