    "随时记下这一针，这一行。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时记下这一针，这一行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your place, stitch by stitch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時記下這一針，這一行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと目ずつ、今どこかを見失わない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 코 한 코, 내 위치를 지키세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte deine Stelle, Masche für Masche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu lugar, punto a punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ta place, maille après maille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perca o lugar, ponto a ponto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non perdere il segno, punto dopo punto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raak je plek niet kwijt, steek voor steek."
          }
        }
      }
    },
