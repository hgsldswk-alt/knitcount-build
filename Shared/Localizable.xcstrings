          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist zu lang. Nutze weniger Teile oder kürzere Notizen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código es demasiado largo. Usa menos piezas o notas más cortas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code est trop long. Utilise moins d’ouvrages ou des notes plus courtes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código é longo demais. Use menos peças ou notas mais curtas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice è troppo lungo. Usa meno pezzi o note più brevi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is te lang. Gebruik minder delen of kortere notities."
          }
        }
      }
    },
