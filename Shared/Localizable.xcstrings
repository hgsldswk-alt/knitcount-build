    "单指涂色，双指缩放或移动。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指涂色，双指缩放或移动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paint with one finger. Pinch or pan with two."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指塗色，雙指縮放或移動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本指で塗り、2本指でピンチや移動ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 칠하고, 두 손가락으로 확대하거나 옮기세요."
          }
