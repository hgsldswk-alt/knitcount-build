    },
    "无限作品与计数器、联动、行提醒、圆环和网格跟踪、荧光笔、锁屏计数与计时统计。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限作品与计数器、联动、行提醒、圆环和网格跟踪、荧光笔、锁屏计数与计时统计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited projects and counters, linked counting, row reminders, ring and grid tracking, highlighting, Lock Screen counting and time tracking."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無限作品與計數器、聯動、行提醒、圓環和網格跟蹤、螢光筆、鎖定畫面計數與計時統計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品とカウンターが無制限、連動カウント、段ごとのリマインダー、輪と方眼の追跡、ハイライト、ロック画面でのカウント、作業時間の記録。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무제한 작품과 카운터, 연동 세기, 단 알림, 원형·격자 추적, 형광펜, 잠금 화면 세기, 시간 기록."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Projekte und Zähler, verknüpftes Zählen, Reihen-Erinnerungen, Runden- und Rasterverfolgung, Markieren, Zählen auf dem Sperrbildschirm und Zeiterfassung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyectos y contadores ilimitados, conteo vinculado, recordatorios por vuelta, seguimiento en anillo y cuadrícula, resaltado, conteo en la pantalla bloqueada y registro de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projets et compteurs illimités, comptage lié, rappels par rang, suivi en rond et en grille, surlignage, comptage sur l’écran verrouillé et suivi du temps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetos e contadores ilimitados, contagem vinculada, lembretes por carreira, acompanhamento em volta e em grade, marcação, contagem na tela bloqueada e registro de tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progetti e contatori illimitati, conteggio collegato, promemoria per giro, monitoraggio in tondo e a griglia, evidenziazione, conteggio sulla schermata di blocco e registro del tempo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkt projecten en tellers, gekoppeld tellen, herinneringen per toer, rond en ruitjes volgen, markeren, tellen op het toegangsscherm en tijdlogboek."
          }
        }
      }
    },
