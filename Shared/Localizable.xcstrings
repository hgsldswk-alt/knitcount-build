    "缩写采用美式术语：美式 sc 对应英式 dc，美式 dc 对应英式 tr。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩写采用美式术语：美式 sc 对应英式 dc，美式 dc 对应英式 tr。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbreviations use US terms: US sc is UK dc; US dc is UK tr."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮寫採用美式術語：美式 sc 對應英式 dc，美式 dc 對應英式 tr。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "略語は米式表記です（米式 sc = 細編み、dc = 長編み）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약어는 미국식입니다: 미국 sc는 영국 dc, 미국 dc는 영국 tr입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abkürzungen nach US-Begriffen: US sc = feste Masche (UK dc); US dc = Stäbchen (UK tr)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las abreviaturas usan términos de EE. UU.: sc de EE. UU. = punto bajo (dc del R. U.); dc de EE. UU. = vareta (tr del R. U.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abréviations suivent les termes US : sc US = maille serrée (dc UK) ; dc US = bride (tr UK)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abreviações usam termos dos EUA: sc EUA = ponto baixo (dc no Reino Unido); dc EUA = ponto alto (tr no Reino Unido)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le abbreviazioni usano i termini USA: sc USA = maglia bassa (dc UK); dc USA = maglia alta (tr UK)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afkortingen gebruiken Amerikaanse termen: US sc = vaste (UK dc); US dc = stokje (UK tr)."
          }
        }
      }
    },
    "网格": {
