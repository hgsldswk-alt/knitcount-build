    "记下织前余线，织几行再填织后余线。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记下织前余线，织几行再填织后余线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your yarn, work a few rows, then measure again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記下織前餘線，織幾行再填織後餘線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毛糸を測り、数段編んでから、もう一度測ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실을 재고 몇 단 뜬 다음 다시 재세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss dein Garn, arbeite ein paar Reihen und miss erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide tu lana, teje unas vueltas y vuelve a medir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure ta laine, tricote quelques rangs et mesure à nouveau."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça o fio, faça algumas carreiras e meça de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura il filato, lavora qualche giro e misura di nuovo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet het garen, werk een paar toeren en meet opnieuw."
          }
        }
      }
    },
    "织前余线须大于织后余线，行数须大于零，预留不能为负。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "织前余线须大于织后余线，行数须大于零，预留不能为负。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter less yarn after, at least one row, and a reserve of zero or more."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "織前餘線須大於織後餘線，行數須大於零，預留不能為負。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「編んだ後」は少なめに、段数は1段以上、予備は0以上を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜬 후 실은 더 적게, 단수는 1 이상, 여유분은 0 이상으로 입력하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib nachher weniger Garn ein, mindestens eine Reihe und eine Reserve von null oder mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe menos lana después, al menos una vuelta y una reserva de cero o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
