    "燕麦色开衫\nRow 45: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 46: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 47: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 120: Bind off (80 sts)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "燕麦色开衫\nRow 45: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 46: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 47: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 120: Bind off (80 sts)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oatmeal cardigan\nRow 45: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 46: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 47: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 120: Bind off (80 sts)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "燕麥色開襟衫\nRow 45: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 46: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 47: K36 (40, 44, 48), P2 (2, 4, 4) (80 sts)\nRow 120: Bind off (80 sts)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートミール色のカーディガン\n45段：表36（40、44、48）、裏2（2、4、4）（80目）\n46段：表36（40、44、48）、裏2（2、4、4）（80目）\n47段：表36（40、44、48）、裏2（2、4、4）（80目）\n120段：伏せ止め（80目）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오트밀 카디건\n45단: 겉뜨기 36 (40, 44, 48), 안뜨기 2 (2, 4, 4) (80코)\n46단: 겉뜨기 36 (40, 44, 48), 안뜨기 2 (2, 4, 4) (80코)\n47단: 겉뜨기 36 (40, 44, 48), 안뜨기 2 (2, 4, 4) (80코)\n120단: 코 막음 (80코)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haferflocken-Cardigan\nR 45: 36 re (40, 44, 48), 2 li (2, 4, 4) (80 M)\nR 46: 36 re (40, 44, 48), 2 li (2, 4, 4) (80 M)\nR 47: 36 re (40, 44, 48), 2 li (2, 4, 4) (80 M)\nR 120: Abketten (80 M)"
          }
        }
      }
    },
