    "音量键只在跟织页前台生效，可能影响其他音频的音量。默认关闭。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音量键只在跟织页前台生效，可能影响其他音频的音量。默认关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume counting works only on the active stitching screen and may affect other audio. Off by default."
