    "体验已结束，已有作品仍可查看、计数和导出。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体验已结束，已有作品仍可查看、计数和导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended. You can still view, count and export existing projects."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體驗已結束，已有作品仍可查看、計數和匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し期間が終了しました。既存の作品の閲覧・カウント・書き出しは引き続きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝났습니다. 기존 작품은 계속 보고, 세고, 내보낼 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist beendet. Vorhandene Projekte kannst du weiter ansehen, zählen und exportieren."
          }
        }
      }
    },
