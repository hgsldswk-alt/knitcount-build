    "缩写采用美式术语：美式 sc 对应英式 dc，美式 dc 对应英式 tr。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩写采用美式术语：美式 sc 对应英式 dc，美式 dc 对应英式 tr。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbreviations use US terms: US sc is UK dc; US dc is UK tr."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮寫採用美式術語：美式 sc 對應英式 dc，美式 dc 對應英式 tr。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "略語は米式表記です（米式 sc = 細編み、dc = 長編み）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약어는 미국식입니다: 미국 sc는 영국 dc, 미국 dc는 영국 tr입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abkürzungen nach US-Begriffen: US sc = feste Masche (UK dc); US dc = Stäbchen (UK tr)."
